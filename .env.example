ENVIRONMENT=development
NODE_ENV=development

# ports
POSTGRES_PUBLISHED_PORT=5432
SERVER_PUBLISHED_PORT=3000
CLIENT_PUBLISHED_PORT=8080

# client
VITE_BACKEND_URL=http://localhost:3000

# server
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# database
POSTGRES_USER=narrator
POSTGRES_PASSWORD=narrator
POSTGRES_DB=narrator_dev
DATABASE_ADAPTER=pg
DATABASE_URL=postgresql://narrator:narrator@localhost:5432/narrator_dev
DATABASE_URL_DIRECT=postgresql://narrator:narrator@localhost:5432/narrator_dev

# auth
BETTER_AUTH_SECRET=change-me-local-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2
R2_ENDPOINT=https://example-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=narrator-web-dev
R2_ACCESS_KEY_ID=example-access-key-id
R2_SECRET_ACCESS_KEY=example-secret-access-key

# openapi
OPENROUTER_API_KEY=sk-or-v1-...
