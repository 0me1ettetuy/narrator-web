datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  output          = "../src/db/generated/prisma"
}

model User {
  id  String  @id @default(cuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id String @id @default(cuid())
  token String @unique
  userId String
  familyId String
  expiresAt DateTime
  rotatedAt DateTime?
  replacedById String? @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}