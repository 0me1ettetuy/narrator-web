{
  "name": "@narrator/server",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names server,types,aliases \"DOTENV_CONFIG_PATH=../../.env tsx watch src/index.ts\" \"tsc --watch --preserveWatchOutput\" \"tsc-alias --watch\"",
    "prebuild": "DOTENV_CONFIG_PATH=../../.env prisma generate",
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "DOTENV_CONFIG_PATH=../../.env prisma migrate dev",
    "db:generate": "DOTENV_CONFIG_PATH=../../.env prisma generate",
    "db:seed": "DOTENV_CONFIG_PATH=../../.env tsx prisma/seed.ts",
    "db:reset": "DOTENV_CONFIG_PATH=../../.env prisma migrate reset"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@narrator/schema": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@trpc/server": "catalog:",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.3",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prisma": "^7.8.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.3",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
